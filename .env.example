# Copy this file to `.env` and `.env.local`, then fill in values (never commit real secrets).

# --- Database (required) ---
# SQLite file relative to prisma folder
DATABASE_URL="file:./dev.db"

# --- NextAuth (required for login) ---
# Generate a random string at least 32 characters, e.g. openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Base URL of your app when running locally
NEXTAUTH_URL="http://localhost:3000"

# --- Groq AI (required for AI chat, skill assessment, assignment analysis) ---
# Create a key at https://console.groq.com/keys — same key can be used for both if you prefer.
GROQ_API_KEY=""
# Optional: used by skill-assessment API; falls back to GROQ_API_KEY if empty
GROQ_SKILL_KEY=""

# Optional: OpenAI is in dependencies but current AI routes use Groq only.
