# Copy this file to `.env.local` and fill in the values (never commit real secrets).

# --- Database (required) ---
# Local SQLite (for dev only):
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# Production PostgreSQL (Neon.tech / Supabase / Vercel Postgres):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- NextAuth (required for login) ---
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Set this to your Vercel deployment URL in production
NEXTAUTH_URL="https://your-project.vercel.app"

# --- Groq AI (required for AI features) ---
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: used by skill-assessment API; falls back to GROQ_API_KEY if empty
GROQ_SKILL_KEY=""
